}
.category-scroll.data-v-1cf27b2a {
  white-space: nowrap;
  padding: 16rpx 24rpx;
  background-color: transparent;
}
.category-scroll .category-list.data-v-1cf27b2a {
  display: inline-flex;
  gap: 16rpx;
}
.category-scroll .category-list .category-item.data-v-1cf27b2a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 32rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #555;
  background-color: rgba(255, 255, 255, 0.7);
  border: 2rpx solid transparent;
  transition: all 0.2s;
  flex-shrink: 0;
}
.category-scroll .category-list .category-item.active.data-v-1cf27b2a {
  background-color: #ffc107;
  color: #333;
