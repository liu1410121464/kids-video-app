/* 全局scss变量 */
.container.data-v-1cf27b2a {
  min-height: 100vh;
  background-color: #a8d5ba;
  display: flex;
  flex-direction: column;
}
.nav-bar.data-v-1cf27b2a {
  background-color: transparent;
  padding-left: 30rpx;
  padding-right: 30rpx;
}
.nav-bar .nav-content.data-v-1cf27b2a {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.nav-bar .nav-content .nav-left.data-v-1cf27b2a {
  display: flex;
  align-items: center;
