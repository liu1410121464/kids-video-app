  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
  background-color: #ffc107;
  border: 2rpx solid #ffb300;
}
.nav-bar .nav-content .nav-left .login-btn .login-text.data-v-1cf27b2a {
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
}
.nav-bar .nav-content .nav-title.data-v-1cf27b2a {
  font-size: 34rpx;
