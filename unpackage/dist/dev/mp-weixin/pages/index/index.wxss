/* 全局scss变量 */
.container.data-v-1cf27b2a {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff8f0 0%, #fff0e6 100%);
  padding-bottom: 40rpx;
}

/* 导航栏 */
.nav-bar.data-v-1cf27b2a {
  background: transparent;
}
.nav-content.data-v-1cf27b2a {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 30rpx 20rpx;
}
.nav-logo.data-v-1cf27b2a {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.logo-emoji.data-v-1cf27b2a {
  font-size: 48rpx;
}
.logo-text.data-v-1cf27b2a {
  font-size: 40rpx;
  font-weight: bold;
  color: #ff6b35;
}

/* 欢迎区域 */
.welcome-section.data-v-1cf27b2a {
  padding: 20rpx 30rpx 30rpx;
}
.welcome-card.data-v-1cf27b2a {
  background: linear-gradient(135deg, #ff6b35 0%, #ff8c42 100%);
  border-radius: 24rpx;
  padding: 36rpx 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.3);
}
.welcome-title.data-v-1cf27b2a {
  font-size: 40rpx;
  font-weight: bold;
  color: #ffffff;
  display: block;
  margin-bottom: 8rpx;
}
.welcome-subtitle.data-v-1cf27b2a {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 功能区域 */
.feature-section.data-v-1cf27b2a {
  padding: 0 30rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.feature-card.data-v-1cf27b2a {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx 30rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  position: relative;
  transition: transform 0.2s;
}
.feature-card.data-v-1cf27b2a:active {
  transform: scale(0.98);
}
.feature-main.data-v-1cf27b2a {
  border: 3rpx solid #ff6b35;
  background: linear-gradient(135deg, #fff8f0 0%, #ffffff 100%);
}
.feature-coming.data-v-1cf27b2a {
  opacity: 0.7;
}
.feature-icon.data-v-1cf27b2a {
  font-size: 60rpx;
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff0e6;
  border-radius: 50%;
  flex-shrink: 0;
}
.feature-info.data-v-1cf27b2a {
  flex: 1;
}
.feature-title.data-v-1cf27b2a {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  display: block;
  margin-bottom: 6rpx;
}
.feature-desc.data-v-1cf27b2a {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.5;
}
.feature-arrow.data-v-1cf27b2a {
  font-size: 40rpx;
  color: #ff6b35;
  font-weight: bold;
}
.coming-badge.data-v-1cf27b2a {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: #f0f0f0;
  color: #999999;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

/* 底部提示 */
.footer-tip.data-v-1cf27b2a {
  padding: 40rpx 30rpx 0;
  text-align: center;
}
.tip-text.data-v-1cf27b2a {
  font-size: 24rpx;
  color: #cccccc;
}