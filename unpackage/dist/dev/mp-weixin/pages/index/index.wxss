  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}
.video-card .card-cover-wrap.data-v-1cf27b2a {
  position: relative;
  width: 100%;
  height: 240rpx;
}
.video-card .card-cover-wrap .card-cover.data-v-1cf27b2a {
  width: 100%;
  height: 100%;
}
.video-card .card-cover-wrap .episode-badge.data-v-1cf27b2a {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background-color: rgba(0, 0, 0, 0.5);
